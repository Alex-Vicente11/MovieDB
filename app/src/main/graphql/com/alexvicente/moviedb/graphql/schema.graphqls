type Genre {
  id: Int!
  name: String!
}

type Movie {
  id: Int!
  title: String!
  overview: String!
  posterPath: String!
  backdropPath: String
  releaseDate: String!
  voteAverage: Float!
  voteCount: Int!
  popularity: Float!
  genres: [Genre!]!
}

type Query {
  popularMovies(page: Int! = 1): [Movie!]!
  movieDetail(movieId: Int!): Movie!
}
